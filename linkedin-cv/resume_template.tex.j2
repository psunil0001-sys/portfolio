\documentclass[11pt,a4paper]{article}
\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage[margin=0.7in]{geometry}
\usepackage{enumitem}
\usepackage{hyperref}

% ATS-friendly: selectable text, single column, standard headings, no tables.
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    urlcolor=black,
    pdftitle={[[ name ]] - Resume},
    pdfauthor={[[ name ]]}
}

\usepackage{titlesec}
\titleformat{\section}{\large\bfseries}{}{0em}{}[\titlerule]
\titlespacing*{\section}{0pt}{10pt}{4pt}

\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\setlist[itemize]{leftmargin=*,nosep,topsep=2pt,itemsep=2pt}

\newcommand{\jobhead}[4]{%
  \textbf{#1}\\
  \small #2 $|$ #3 $|$ #4\par
  \vspace{2pt}
}

\begin{document}

{\LARGE\bfseries [[ name ]]}\\[4pt]
[[ title ]] $|$ [[ headline ]]\\[4pt]
\small [[ location ]] $|$ \href{mailto:[[ email ]]}{[[ email ]]} $|$ [[ phone ]]\\
\small \href{https://[[ linkedin ]]}{[[ linkedin ]]} $|$ \href{https://[[ github ]]}{[[ github ]]}

\section{Professional Summary}
[[ summary ]]

\section{Technical Skills}
\begin{itemize}
[% for group in skill_groups %]
    \item \textbf{[[ group.label ]]:} [[ group.skills | join(', ') ]]
[% endfor %]
    \item \textbf{Spoken languages:} [[ spoken_languages | join(', ') ]]
\end{itemize}

\section{Professional Experience}
[% for job in experience %]
\jobhead{[[ job.role ]]}{[[ job.company ]][% if job.client %] (Client: [[ job.client ]])[% endif %]}{[[ job.location ]]}{[[ job.period ]]}
\begin{itemize}
[% for bullet in job.bullets %]
    \item [[ bullet ]]
[% endfor %]
\end{itemize}
\vspace{6pt}
[% endfor %]

[% if projects %]
\section{Projects}
[% for project in projects %]
\textbf{[[ project.title ]]} $|$ [[ project.stack ]][% if project.freelance %] $|$ Freelance[% endif %]\\
\small \href{[[ project.url ]]}{[[ project.url ]]}\\[2pt]
[[ project.blurb ]]
\vspace{6pt}
[% endfor %]
[% endif %]

\section{Education}
\textbf{[[ education.degree ]]}\\
\small [[ education.school ]] $|$ [[ education.location ]] $|$ [[ education.period ]]

\section{Certifications}
\begin{itemize}
[% for cert in certifications %]
    \item [[ cert ]]
[% endfor %]
\end{itemize}

\end{document}
